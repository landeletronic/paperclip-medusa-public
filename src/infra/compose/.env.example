# Copie para .env e substitua todos os valores replace-with-*. O arquivo .env real é ignorado.
# Use somente valores URL-safe (por exemplo, saída hexadecimal) nas senhas PostgreSQL.

# Paperclip
PAPERCLIP_DB_PASSWORD=replace-with-random-hex-paperclip-db-password
BETTER_AUTH_SECRET=replace-with-random-hex-better-auth-secret
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=replace-with-random-hex-tool-action-secret
PAPERCLIP_AGENT_JWT_SECRET=replace-with-random-hex-agent-jwt-secret
# URL pública usada pelos clientes (E6: HTTPS na tailnet via tailscale serve). Em acesso só local, use http://127.0.0.1:3100.
PAPERCLIP_PUBLIC_URL=https://primary-host-jones-hermes.tail07368.ts.net
# Inclua o hostname MagicDNS da tailnet quando publicado via tailscale serve.
PAPERCLIP_ALLOWED_HOSTNAMES=primary-host-jones-hermes,paperclip,primary-host-jones-hermes.tail07368.ts.net
PAPERCLIP_PORT=3100

# LiteLLM
LITELLM_DB_PASSWORD=replace-with-random-hex-litellm-db-password
LITELLM_MASTER_KEY=sk-replace-with-random-litellm-master-key
LITELLM_SALT_KEY=sk-replace-with-random-litellm-salt-key
LITELLM_PORT=4000
LITELLM_CONFIG_PATH=../../gateway/config.yaml

# Ollama local existente no host principal. Nenhum provedor de IA externo é permitido.
OLLAMA_DOCKER_NETWORK=hermes-architect_backend
OLLAMA_PRIMARY_BASE_URL=http://ollama:11434
OLLAMA_FALLBACK_BASE_URL=http://ollama:11434
